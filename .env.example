# Render Free: use lite to avoid ML and Chroma runtime memory pressure.
AEGIS_DEPLOYMENT_PROFILE=standard
AEGIS_LLM=local
AEGIS_EMBEDDINGS=local
AEGIS_EMBEDDING_MODEL=all-MiniLM-L6-v2
AEGIS_GEMINI_MODEL=gemini-3.5-flash
AWS_REGION=us-east-2
AEGIS_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AEGIS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AEGIS_RETRIEVAL_K=4
AEGIS_RETRIEVAL_SCORE_THRESHOLD=0
AEGIS_PROVIDER_TIMEOUT_SECONDS=30
AEGIS_MAX_OUTPUT_TOKENS=500
AEGIS_MAX_AGENT_ATTEMPTS=2
AEGIS_DEMO_MAX_CONCURRENCY=1
AEGIS_DEMO_REQUESTS_PER_MINUTE=10
# Optional relative paths are resolved from the repository root.
AEGIS_DATASET_PATH=data/documents
AEGIS_DATABASE_PATH=data/aegis.db
AEGIS_VECTOR_STORE_PATH=.
# GEMINI_API_KEY=<set only in a secret manager or process environment>
